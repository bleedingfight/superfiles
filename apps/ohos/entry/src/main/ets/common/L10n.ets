function s2t(s: string): string {
  let out: string = '';
  for (let i = 0; i < s.length; i++) {
    const ch: string = s.charAt(i);
    const mapped: string | undefined = S2T.get(ch);
    out += mapped === undefined ? ch : mapped;
  }
  return out;
}

export function detectSystemLang(): string {
  let sys: string = 'en';
  try {
    sys = i18n.System.getSystemLanguage();
  } catch (e) {
    sys = 'en';
  }
  const low: string = sys.toLowerCase();
  if (low.indexOf('zh') === 0) {
    if (sys.indexOf('Hant') >= 0 || sys.indexOf('TW') >= 0 ||
        sys.indexOf('HK') >= 0 || sys.indexOf('MO') >= 0) {
      return 'zhHant';
    }
    return 'zh';
  }
  return 'en';
}

function resolve(lang: string): string {
  if (lang === 'auto' || lang.length === 0) {
    return detectSystemLang();
  }
  return lang;
}

export function t(lang: string, key: string, ...args: string[]): string {
  const r: string = resolve(lang);
  let s: string;
  if (r === 'en') {
    s = EN.get(key) === undefined ? (ZH.get(key) === undefined ? key : ZH.get(key) as string)
                                  : EN.get(key) as string;
  } else {
    s = ZH.get(key) === undefined ? key : ZH.get(key) as string;
    if (r === 'zhHant') {
      s = s2t(s);
    }
  }
  for (let i = 0; i < args.length; i++) {
    s = s.replace(`{${i}}`, args[i]);
  }
  return s;
}
