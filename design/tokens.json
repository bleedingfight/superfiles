{
  "$description": "Super Files design tokens (W3C DTCG). 语义角色为主：颜色在两端运行时跟随系统（Material You / iOS 系统蓝），此文件的色值仅作 Figma 参考稿的演示基线。",
  "color": {
    "role": {
      "primary": { "$type": "color", "$value": "#6750A4", "$description": "目录图标/主操作/链接（演示值，运行时 = Material You / accentColor）" },
      "onSurface": { "$type": "color", "$value": "#1D1B20", "$description": "文件名" },
      "onSurfaceVariant": { "$type": "color", "$value": "#49454F", "$description": "次信息：尺寸·日期·mime" },
      "outline": { "$type": "color", "$value": "#79747E", "$description": "弱化提示：chevron、空态图标" },
      "error": { "$type": "color", "$value": "#B3261E", "$description": "危险操作：删除" },
      "focusRing": { "$type": "color", "$value": "#6750A4", "$description": "TV 焦点边框（合同：边框+背景，禁缩放）" },
      "focusBackground": { "$type": "color", "$value": "#E6E0E9", "$description": "TV 焦点背景 = surfaceVariant" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4dp", "$description": "文字行内微调" },
    "2": { "$type": "dimension", "$value": "8dp", "$description": "空态元素间距" },
    "3": { "$type": "dimension", "$value": "12dp", "$description": "图标-文字" },
    "4": { "$type": "dimension", "$value": "16dp", "$description": "屏幕安全边距" },
    "6": { "$type": "dimension", "$value": "24dp", "$description": "分组间隔（预留）" },
    "8": { "$type": "dimension", "$value": "32dp", "$description": "段落级空白（预留）" }
  },
  "rowIcon": {
    "slot": { "$type": "dimension", "$value": "28dp", "$description": "FileRow 图标槽固定宽" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "12dp", "$description": "卡片/对话框圆角（M3 medium）" },
    "button": { "$type": "dimension", "$value": "20dp", "$description": "按钮（M3 full）" }
  },
  "type": {
    "fileName": { "$type": "typography", "$value": "{ \"android\": \"bodyLarge\", \"ios\": \"body\" }", "$description": "文件名" },
    "secondary": { "$type": "typography", "$value": "{ \"android\": \"bodySmall\", \"ios\": \"caption\" }", "$description": "尺寸/日期/mime" },
    "appBar": { "$type": "typography", "$value": "{ \"android\": \"titleLarge\", \"ios\": \"headline\" }", "$description": "AppBar 标题" },
    "emptyTitle": { "$type": "typography", "$value": "{ \"android\": \"titleMedium\", \"ios\": \"headline\" }", "$description": "空态主文案" },
    "emptyBody": { "$type": "typography", "$value": "{ \"android\": \"bodySmall\", \"ios\": \"footnote\" }", "$description": "空态辅文案" },
    "footer": { "$type": "typography", "$value": "{ \"android\": \"labelSmall\", \"ios\": \"caption2\" }", "$description": "底部状态栏" }
  }
}
