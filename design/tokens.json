{
  "$description": "Super Files design tokens (W3C DTCG). v0.1: 以 Figma「superfiles」稿实测值为造型基准（色彩=其演示值；运行时 Android 仍跟随 Material You，iOS 跟随系统色——本文件是 Figma 摆稿与 fallbakc 参考的标准基线）。噪点值已向 4 基栅取整。",
  "color": {
    "role": {
      "surface": { "$type": "color", "$value": "#F8F7F4", "$description": "暖米白底色（来源 Figma）" },
      "surfaceCard": { "$type": "color", "$value": "#FFFFFF", "$description": "卡片底（文件夹/用量/详情卡）" },
      "surfaceTint": { "$type": "color", "$value": "#EAF0F8", "$description": "信息卡底色（用量卡，近似 primaryContainer 的暖场版）" },
      "primary": { "$type": "color", "$value": "#466DA6", "$description": "CTA/链接/状态 - 决策①待拍板（备选：暖棕 #A18460）" },
      "primaryWarm": { "$type": "color", "$value": "#A18460", "$description": "暖棕点缀（品牌色候选）" },
      "success": { "$type": "color", "$value": "#6F8D7D", "$description": "在线/成功态（ServerCard 状态点）" },
      "onSurface": { "$type": "color", "$value": "#292E35", "$description": "文件名/正文墨色" },
      "onSurfaceVariant": { "$type": "color", "$value": "#777D86", "$description": "次信息：尺寸·日期·mime" },
      "outline": { "$type": "color", "$value": "#A4A8AE", "$description": "弱化图标/边框" },
      "error": { "$type": "color", "$value": "#B3261E", "$description": "危险操作：删除" },
      "focusRing": { "$type": "color", "$value": "#466DA6", "$description": "TV 焦点边框（合同：边框+背景，禁缩放）；默认值跟随决策①联动" },
      "focusBackground": { "$type": "color", "$value": "#EAF0F8", "$description": "TV 焦点背景 = surfaceTint" }
    },
    "dark": {
      "$description": "v0.2 派生草案：Figma 只有浅色稿，深色由浅色基线同语义角色反相/调明度得到（蓝/暖棕/绿提亮、层级面压暗保留暖调）；Android 已随系统夜间模式生效，Figma 正式深色稿出来后按稿校准。AV/相册类缩略图不受配色影响。",
      "role": {
        "surface": { "$type": "color", "$value": "#1A1916" },
        "surfaceCard": { "$type": "color", "$value": "#26231F" },
        "surfaceTint": { "$type": "color", "$value": "#22324A" },
        "primary": { "$type": "color", "$value": "#A9C3E6" },
        "primaryWarm": { "$type": "color", "$value": "#C7A87F" },
        "success": { "$type": "color", "$value": "#9CB8A9" },
        "onSurface": { "$type": "color", "$value": "#E7E5E1" },
        "onSurfaceVariant": { "$type": "color", "$value": "#A0A5AD" },
        "outline": { "$type": "color", "$value": "#6A7078" },
        "error": { "$type": "color", "$value": "#F2B8B5" },
        "focusRing": { "$type": "color", "$value": "#A9C3E6", "$description": "跟随 dark primary（TV 高对比深色不做动态取色，docs/06 §1）" },
        "focusBackground": { "$type": "color", "$value": "#22324A" }
      }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4dp", "$description": "行内细距（Figma 里 5 已 snap）" },
    "2": { "$type": "dimension", "$value": "8dp", "$description": "空态元素间距（7 已 snap）" },
    "3": { "$type": "dimension", "$value": "12dp", "$description": "图标-文字（13 已 snap）" },
    "4": { "$type": "dimension", "$value": "16dp", "$description": "组件内 padding" },
    "6": { "$type": "dimension", "$value": "24dp", "$description": "屏幕左右安全边距（Figma 实测）" },
    "8": { "$type": "dimension", "$value": "32dp", "$description": "段落级空白（预留）" }
  },
  "safeMargin": { "$type": "dimension", "$value": "24dp", "$alias": "{space.6}", "$description": "屏幕左右边距别名（语义入口）" },
  "rowIcon": {
    "slot": { "$type": "dimension", "$value": "28dp", "$description": "FileRow 图标槽固定宽" }
  },
  "radius": {
    "s": { "$type": "dimension", "$value": "10dp", "$description": "芯片/小卡/排序器" },
    "m": { "$type": "dimension", "$value": "14dp", "$description": "常规卡片（文件夹/详情预览）" },
    "l": { "$type": "dimension", "$value": "20dp", "$description": "主卡（用量卡/分享区）" },
    "pill": { "$type": "dimension", "$value": "999dp", "$description": "搜索框/过滤 chip/CTA 按钮（Figma 99）" }
  },
  "type": {
    "stack": { "$type": "fontFamily", "$value": "'Noto Sans SC', 'PingFang SC', system-ui", "$description": "中文优先字栈；数字可用 Inter/系统数字" },
    "appBar": { "$type": "typography", "$value": "{ \"size\": 17, \"weight\": 700 }", "$description": "AppBar 标题" },
    "fileName": { "$type": "typography", "$value": "{ \"size\": 14, \"weight\": 500 }", "$description": "文件名（74dp 行高自洽，高于 M3 列表密度）" },
    "secondary": { "$type": "typography", "$value": "{ \"size\": 10, \"weight\": 400 }", "$description": "元信息：尺寸/日期/mime（元信息行高 13）" },
    "cardTitle": { "$type": "typography", "$value": "{ \"size\": 12, \"weight\": 500 }", "$description": "分组标题（我的文件夹/最近打开）" },
    "emptyTitle": { "$type": "typography", "$value": "{ \"size\": 15, \"weight\": 500 }", "$description": "空态主文案" },
    "emptyBody": { "$type": "typography", "$value": "{ \"size\": 13, \"weight\": 400 }", "$description": "空态辅文案" },
    "footer": { "$type": "typography", "$value": "{ \"size\": 10, \"weight\": 400 }", "$description": "底部状态栏" }
  }
}
